{
  "title": "Customer Churn API",
  "uid": "churn-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "churn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(churn_prediction_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "churn-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Proporcion de errores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "churn-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(churn_prediction_requests_total{outcome!=\"success\"}[1m])) / sum(rate(churn_prediction_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "churn-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia p95 de respuestas exitosas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "churn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(churn_prediction_duration_seconds_bucket[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "churn-prometheus"
          }
        }
      ]
    }
  ]
}
